# Copy this file to backend/.env. Replace all REPLACE values with random secrets.
DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_DB_PASSWORD@127.0.0.1:5432/securitas
ACCESS_TOKEN_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
REFRESH_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
RSA_PRIVATE_KEY_PASSPHRASE=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=false
DOCUMENT_STORAGE_DIR=./private_uploads
RSA_PRIVATE_KEY_DIR=./private_keys
